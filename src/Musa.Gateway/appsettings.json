{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "bids": {
        "ClusterId": "auctions", "RateLimiterPolicy": "bids",
        "Match": { "Path": "/api/auctions/lots/{lot}/bids", "Methods": [ "POST" ] },
        "Transforms": [ { "PathRemovePrefix": "/api/auctions" } ]
      },
      "auctions": { "ClusterId": "auctions", "Match": { "Path": "/api/auctions/{**rest}" }, "Transforms": [ { "PathRemovePrefix": "/api/auctions" } ] },
      "catalog": { "ClusterId": "catalog", "Match": { "Path": "/api/catalog/{**rest}" }, "Transforms": [ { "PathRemovePrefix": "/api/catalog" } ] },
      "orders": { "ClusterId": "ordering", "Match": { "Path": "/api/ordering/{**rest}" }, "Transforms": [ { "PathRemovePrefix": "/api/ordering" } ] },
      "provenance": { "ClusterId": "provenance", "Match": { "Path": "/api/provenance/{**rest}" }, "Transforms": [ { "PathRemovePrefix": "/api/provenance" } ] },
      "journal": { "ClusterId": "journal", "Match": { "Path": "/api/journal/{**rest}" }, "Transforms": [ { "PathRemovePrefix": "/api/journal" } ] }
    },
    "Clusters": {
      "auctions": { "Destinations": { "d1": { "Address": "http://auctions-api" } } },
      "catalog": { "Destinations": { "d1": { "Address": "http://catalog-api" } } },
      "ordering": { "Destinations": { "d1": { "Address": "http://ordering-api" } } },
      "provenance": { "Destinations": { "d1": { "Address": "http://provenance-api" } } },
      "journal": { "Destinations": { "d1": { "Address": "http://journal-api" } } }
    }
  }
}
